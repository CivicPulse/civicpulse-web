---
import Layout from '../layouts/Layout.astro';
import { resolvePublicContentSource } from '../lib/content-source.mjs';
const cmsMode = resolvePublicContentSource(import.meta.env.PUBLIC_CONTENT_SOURCE) === 'supabase';
import Icon from '../components/Icon.astro';
import { maps, layers } from '../data/maps';
import { eventLocations, mappedEvents } from '../lib/event-map';
import qgisStyle from '../data/qgis-style.json';
import { calendars, organizations } from '../lib/calendars';
const markerOrganizations = organizations.filter(organization => mappedEvents.some(event => event.organizationId === organization.id));
const venueCount = new Set(eventLocations.features.map(feature => feature.geometry.coordinates.join(','))).size;
const initialMap = maps[0] || { description: 'No maps are published in this snapshot.', layers: [] };
import { commissionColors } from '../data/commission-style';
import libraryCounties from '../data/library-counties.json';
import { mapLayerGroups, layerGroup, transitServicePeriod, officialFeatureColor, isSchoolPointLayer, schoolIcon } from '../data/education-transit';
---
<Layout title="Explore maps" description={cmsMode ? "Explore the maps and places in the published community snapshot." : "Explore schools, attendance boundaries, school-board districts, transit routes, county recreation centers, Middle Georgia libraries, community events, commission districts, polling places and voting precincts."}>
  <main id="main">
    <div class="page-intro"><h1>Find your way around.</h1><p>A different view of Macon–Bibb. Choose a map, then make it your own with layers.</p></div>
    <div class="map-workspace">
      <aside class="map-sidebar" aria-label="Map settings">
        <label class="field-label" for="map-choice">Choose a map</label>
        <select id="map-choice" aria-describedby="map-description" disabled>{maps.map(map => <option value={map.id}>{map.name}</option>)}</select>
        <p id="map-description">{initialMap.description}</p>
        {!cmsMode && <section id="voting-downloads" aria-labelledby="voting-downloads-title">
          <h2 id="voting-downloads-title">Printable voting maps</h2>
          <a class="button-link" href="https://files.civpulse.org/maps/Macon-Bibb_23x48_300dpi_Posters.pdf" download aria-describedby="poster-download-detail"><Icon name="download" size={18}/> Download poster PDF</a>
          <p id="poster-download-detail">23 × 48 inches · 32 pages · 262 MB</p>
          <a class="button-link" href="https://files.civpulse.org/maps/Macon-Bibb_Letter_300dpi_All_Maps.pdf" download aria-describedby="letter-download-detail"><Icon name="download" size={18}/> Download letter PDF</a>
          <p id="letter-download-detail">8.5 × 11 inches · 33 pages · 48 MB</p>
          <p class="print-help">Full-resolution PDFs for printing. Large files may take a few minutes to download. Print at actual size (100%).</p>
        </section>}
        {!cmsMode && <><p id="election-map-note" class="map-help" hidden>Statewide Georgia coverage. Search <strong>Bibb</strong> in the directory for local districts. U.S. House: 120th Congress; state legislature: 2026 boundaries. PSC regions are residency districts with statewide voting. <a href="/data/#election-district-sources">District sources &amp; versions</a>.</p>
        <p id="rapid-map-note" class="map-help" hidden>On-demand rideshare zones, separate from fixed bus routes. Both pickup and destination must be inside active zones. <a href="https://rapid.mbcta.net/">Check MBCTA Rapid availability</a>.</p>
        <p id="school-map-note" class="map-help" hidden>Attendance polygons are labeled <strong>2025–26</strong> in the source. Split and temporary elementary zones are retained. <a href="https://www.bcsdk12.net/about-us">Confirm current enrollment assignments with BCSD</a>.</p>
        <p id="transit-map-note" class="map-help" hidden>Schedule snapshot: {transitServicePeriod}. No live arrivals. <strong id="transit-expired" hidden>This schedule has expired.</strong> <a href="https://myride.mbcta.net/">Check current bus information</a>.</p>
        <div id="library-marker-key" class="event-marker-key" hidden><details><summary>Library counties</summary>{libraryCounties.map(county => <p><img src={county.icon} width="20" height="25" alt=""/>{county.name}</p>)}</details><p class="map-help"><a href="https://bibblib.org/directory_page_T49_R56.php">Library WOW</a> is a mobile service. Contact MGRLS to arrange a visit.</p></div>
        <p id="event-map-note" class="map-help" hidden>{mappedEvents.length} calendar events at {venueCount} venues. Locations are approximate; confirm the meeting point with the organizer. <a href="/calendar/">View the full calendar</a>.</p>
        <div id="event-marker-key" class="event-marker-key" hidden><details><summary>Organization &amp; calendar colors</summary>{markerOrganizations.map(organization => <section><h3><img src={organization.id === 'mgdsa' ? '/icons/dsa/marker.svg' : `/icons/organizations/${organization.id}/marker.svg`} width="24" height="30" alt=""/>{organization.name}</h3>{calendars.filter(calendar => calendar.organizationId === organization.id && mappedEvents.some(event => event.calendarIds?.includes(calendar.id))).map(calendar => <p><span style={`background:${calendar.color}`} aria-hidden="true"/>{calendar.name}</p>)}</section>)}<small>A shared venue shows each calendar color.</small></details></div>
        </>}
        <fieldset class="layer-controls"><legend>Map layers <Icon name="layers" size={18}/></legend>
          {(cmsMode ? [{id:'community',name:'Published layers'}] : mapLayerGroups).map(group => <details class="layer-group" data-layer-group={group.id} open={group.id === 'community'}><summary>{group.name}</summary><div>{layers.filter(layer => cmsMode || layerGroup(layer.id) === group.id).map(layer => <label class="layer-control"><input type="checkbox" value={layer.id} disabled checked={(initialMap.layers as string[]).includes(layer.id)} />{cmsMode ? <span class={`layer-swatch ${layer.kind}`} style={`--swatch:${layer.color}`} aria-hidden="true"/> : layer.id === 'rapid-service-area' ? <span class="rapid-swatches" aria-hidden="true">{[1,2,3,4].map(zoneNumber => <i style={`background:${officialFeatureColor({zoneNumber}, 'rapid-service-area')}`}/>)}</span> : isSchoolPointLayer(layer.id) ? <img class="layer-ballot" src={schoolIcon(layer.id)} alt="" width="20" height="25"/> : layer.id === 'recreation-centers' ? <img class="layer-ballot" src="/icons/recreation/center.svg" alt="" width="20" height="25"/> : layer.id === 'libraries' ? <img class="layer-ballot" src="/icons/libraries/library-bibb.svg" alt="" width="20" height="25"/> : layer.id === 'polling-places' ? <img class="layer-ballot" src={qgisStyle.layers.polling_places.EarlyVote.icon} alt="" width="20" height="23"/> : layer.id === 'event-locations' ? <span class="layer-swatch point" style={`--swatch:${layer.color}`} aria-hidden="true"/> : layer.id === 'commission-districts' ? <span class="commission-swatches" aria-hidden="true">{Object.entries(commissionColors).map(([district,color]) => <i style={`background:${color}`} title={`District ${district}`}/>)}</span> : layer.id !== 'voting-precincts' ? <span class={`layer-swatch ${layer.kind}`} style={`--swatch:${layer.color}`} aria-hidden="true"/> : <span class="precinct-swatches" aria-hidden="true">{[...new Set(Object.values(qgisStyle.layers.voting_precincts).map(style => style.color))].map(color => <i style={`background:${color}`}/>)}</span>}<span><strong>{layer.name}</strong><small>{layer.description}</small></span></label>)}</div></details>)}
        </fieldset>
        <label class="basemap-control"><input type="checkbox" id="basemap" checked /> Show street basemap</label>
        <button id="fit-map" type="button">Fit map to visible layers</button>
        <p class="map-help">Select a place on the map or in the directory below to see its details.</p>
        <a class="text-link" href="/data/">Browse GeoJSON sources <Icon name="arrow" size={16}/></a>
      </aside>
      <div class="map-main">
        <div id="map" tabindex="0" aria-label="Interactive community and voting map. Use the place directory below for keyboard access."><p class="map-loading">Loading your map…</p></div>
        <p id="map-status" class="status" role="status">Loading map layers…</p>
        <div id="map-error" class="map-message" hidden><p></p><button id="retry-map" type="button">Reload map</button></div>
        <p id="tile-error" class="map-message" hidden>The street basemap is unavailable. GeoJSON layers still work; turn off the street basemap for a plain view.</p>
      </div>
    </div>
    <section class="place-directory" aria-labelledby="directory-title">
      <div class="directory-heading"><div><h2 id="directory-title">Places on your map</h2><p>Search names, addresses, school-board members, bus routes or stop codes in your selected layers.</p></div><label class="search-field"><span class="sr-only">Search places, precincts or addresses</span><Icon name="search"/><input id="place-search" type="search" placeholder="Search places, precincts or addresses" /></label></div>
      <p id="directory-status" class="status" role="status"></p>
      <div id="place-list"></div>
    </section>
    <noscript><p class="data-notice">Enable JavaScript to use the interactive map. You can still <a href="/data/">download the GeoJSON files</a> and explore them in your preferred mapping application.</p></noscript>
  </main>
</Layout>
<script>
  // Fold the unused graph out of the static build, including lazy chunks.
  if (import.meta.env.PUBLIC_CONTENT_SOURCE === 'supabase') {
    void import('../scripts/cms-map');
  } else {
    void import('../scripts/map');
  }
</script>
<style>
.map-workspace{display:grid;grid-template-columns:285px 1fr;min-height:580px;border:1px solid var(--line);background:var(--paper)}.voting-heading{font-size:28px;margin-bottom:12px}.map-sidebar{padding:24px;border-right:1px solid var(--line)}.field-label{font-weight:600;display:block;font-size:15px;margin-bottom:10px}#map-choice{width:100%;font-size:14px}#map-description{font-size:13px;color:var(--muted);margin:12px 0 26px;min-height:42px}.layer-controls{border:0;margin:0 0 20px;padding:0}.layer-controls legend{font:700 26px var(--serif);margin-bottom:14px;width:100%;display:flex;justify-content:space-between;align-items:center}.layer-control{display:flex;gap:10px;align-items:center;padding:10px 0;min-height:55px}.layer-control input{margin:0}.layer-ballot{flex:none}.commission-swatches{display:grid;grid-template-columns:repeat(3,5px);gap:1px;flex:none}.commission-swatches i{width:5px;height:5px}.precinct-swatches{display:flex;width:16px;height:12px;flex:none}.precinct-swatches i{flex:1}.layer-control strong{font-weight:500;font-size:14px;display:block}.layer-control small{display:block;font-size:11px;color:var(--muted);margin-top:3px}.layer-swatch{width:11px;height:11px;background:var(--swatch);flex:none}.layer-swatch.point{border-radius:50%}.layer-swatch.line{height:3px}.layer-swatch.area{opacity:.6}.basemap-control{display:flex;align-items:center;gap:8px;font-size:13px;border-top:1px solid var(--line);padding-top:20px;min-height:44px}#fit-map{margin-top:16px;width:100%;font-size:13px}.map-help{font-size:12px;color:var(--muted);margin-top:18px}.map-sidebar .text-link{font-size:12px;margin-top:8px}.map-main{min-width:0;position:relative;background:#e4e8d9;display:flex;flex-direction:column}#map{width:100%;min-height:560px;flex:1;z-index:0;background:#e4e8d9}.map-loading{padding:40px;text-align:center}.map-main>.status{padding:10px 16px;background:var(--paper);font-size:12px;border-top:1px solid var(--line)}.map-message{padding:14px 18px;background:#f3e7d5;font-size:13px;line-height:1.6}.map-message button{margin-top:10px;font-size:12px}.place-directory{margin-top:40px}.directory-heading{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:18px}.directory-heading h2{font-size:36px}.directory-heading p{color:var(--muted);font-size:14px;margin-top:8px}.search-field{display:flex;align-items:center;gap:10px}.search-field input{width:260px}#directory-status{margin-bottom:12px}#place-list{display:grid;grid-template-columns:1fr 1fr;column-gap:40px}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:800px){.map-workspace{grid-template-columns:230px 1fr}.map-sidebar{padding:18px}#map{min-height:600px}.directory-heading{align-items:start;flex-direction:column}}
@media(max-width:600px){.map-workspace{display:flex;flex-direction:column}.map-sidebar{border-right:0;border-bottom:1px solid var(--line);padding:18px}.layer-controls{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}.layer-controls legend{margin-bottom:8px}.layer-control{gap:6px}.layer-control strong{font-size:12px}.layer-control small{font-size:10px}#map-description{min-height:0;margin-bottom:18px}.basemap-control{padding-top:12px}#map{min-height:420px}.map-help{margin-top:12px}.map-sidebar .text-link{margin-top:0}#place-list{grid-template-columns:1fr}.directory-heading h2{font-size:32px}.search-field,.search-field input{width:100%}}
</style>
<style is:global>
.place-row{display:flex;align-items:center;gap:12px;padding:15px 0;border-top:1px solid var(--line)}.place-row .place-ballot{width:24px;flex:none}.place-row .place-ballot img{display:block}.place-row .place-dot{width:10px;height:10px;border-radius:50%;flex:none}.place-row div{flex:1;min-width:0}.place-row strong{font-size:15px;font-weight:500;display:block}.place-row small{font-size:12px;color:var(--muted)}.place-row button{font-size:12px;background:transparent;white-space:nowrap}.leaflet-container{font-family:var(--sans)!important}.leaflet-popup-content h3{font:700 24px var(--serif);margin:4px 0 8px}.leaflet-popup-content p{font-size:13px;margin:8px 0}.leaflet-popup-content small{font-size:11px;color:var(--rust-dark)}.leaflet-popup-content-wrapper{border-radius:4px!important}.leaflet-control-attribution{font-size:10px!important}.leaflet-container a{color:var(--ink)}
</style>
<style>
.event-marker-key{margin:16px 0 24px}.event-marker-key summary{min-height:44px;font-size:13px;cursor:pointer;padding:12px 0}.event-marker-key section{margin:12px 0 18px}.event-marker-key h3{font:600 13px var(--sans);display:flex;align-items:center;gap:8px;margin-bottom:8px}.event-marker-key p{font-size:12px;display:flex;align-items:center;gap:8px;margin:7px 0}.event-marker-key p span{width:10px;height:10px;border:1px solid #000;border-radius:50%;flex:none}.event-marker-key small{font-size:11px;color:var(--muted);line-height:1.5;display:block;margin-top:10px}
</style>
<style is:global>
.popup-event-marker{display:inline-block;vertical-align:middle;margin-right:7px}.leaflet-marker-icon.organization-event-marker,.leaflet-marker-icon.library-marker{max-width:none}
</style>
<style>
#library-marker-key .map-help{display:block}
</style>

<style>
.layer-group{border-top:1px solid var(--line)}.layer-group summary{cursor:pointer;font-size:13px;font-weight:600;min-height:44px;padding:12px 0;line-height:1.5}.layer-group>div{padding-bottom:12px}
@media(max-width:600px){.layer-controls{display:block}.layer-group>div{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}}
</style>

<style>.rapid-swatches{display:grid;grid-template-columns:repeat(2,6px);gap:1px;flex:none}.rapid-swatches i{width:6px;height:6px}</style>

<style>
#voting-downloads{margin:0 0 24px;padding-bottom:24px;border-bottom:1px solid var(--line)}#voting-downloads h2{font-size:24px;margin-bottom:14px}#voting-downloads .button-link{width:100%;justify-content:flex-start;font-size:13px;padding:10px 12px}#voting-downloads p{font-size:12px;color:var(--muted);margin:7px 0 16px}#voting-downloads .print-help{margin-bottom:0;line-height:1.6}
</style>
