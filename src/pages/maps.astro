---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { maps, layers } from '../data/maps';
import qgisStyle from '../data/qgis-style.json';
---
<Layout title="Explore maps" description="Explore Macon–Bibb with uploaded polling places and voting precincts, alongside sample community layers.">
  <main id="main">
    <div class="page-intro"><h1>Find your way around.</h1><p>A different view of Macon–Bibb. Choose a map, then make it your own with layers.</p></div>
    <p class="sample-notice"><strong>Uploaded voting data.</strong> Polling records include active, historical and unclassified locations. Record activity is shown in the directory and details. Other community layers remain samples. <a href="/data/">About the data</a></p>
    <div class="map-workspace">
      <aside class="map-sidebar" aria-label="Map settings">
        <label class="field-label" for="map-choice">Choose a map</label>
        <select id="map-choice">{maps.map(map => <option value={map.id}>{map.name}</option>)}</select>
        <p id="map-description">{maps[0].description}</p>
        <fieldset class="layer-controls"><legend>Map layers <Icon name="layers" size={18}/></legend>
          {layers.map(layer => <label class="layer-control"><input type="checkbox" value={layer.id} disabled checked={maps[0].layers.includes(layer.id)} />{layer.id === 'polling-places' ? <img class="layer-ballot" src={qgisStyle.layers.polling_places.EarlyVote.icon} alt="" width="20" height="23"/> : layer.id === 'voting-precincts' ? <span class="precinct-swatches" aria-hidden="true">{[...new Set(Object.values(qgisStyle.layers.voting_precincts).map(style => style.color))].map(color => <i style={`background:${color}`}/>)}</span> : <span class={`layer-swatch ${layer.kind}`} style={`--swatch:${layer.color}`} aria-hidden="true"></span>}<span><strong>{layer.name}</strong><small>{layer.description}</small></span></label>)}
        </fieldset>
        <label class="basemap-control"><input type="checkbox" id="basemap" checked /> Show street basemap</label>
        <button id="fit-map" type="button">Fit map to visible layers</button>
        <p class="map-help">Select a place on the map or in the directory below to see its details.</p>
        <a class="text-link" href="/data/">Browse GeoJSON sources <Icon name="arrow" size={16}/></a>
      </aside>
      <div class="map-main">
        <div id="map" tabindex="0" aria-label="Interactive community and voting map. Use the place directory below for keyboard access."><p class="map-loading">Loading your map…</p></div>
        <p id="map-status" class="status" role="status">Loading map layers…</p>
        <div id="map-error" class="map-message" hidden><p></p><button id="retry-map" type="button">Reload map</button></div>
        <p id="tile-error" class="map-message" hidden>The street basemap is unavailable. GeoJSON layers still work; turn off the street basemap for a plain view.</p>
      </div>
    </div>
    <section class="place-directory" aria-labelledby="directory-title">
      <div class="directory-heading"><div><h2 id="directory-title">Places on your map</h2><p>Search names, precinct codes or polling addresses in your selected layers.</p></div><label class="search-field"><span class="sr-only">Search places, precincts or addresses</span><Icon name="search"/><input id="place-search" type="search" placeholder="Search places, precincts or addresses" /></label></div>
      <p id="directory-status" class="status" role="status"></p>
      <div id="place-list"></div>
    </section>
    <noscript><p class="sample-notice">Enable JavaScript to use the interactive map. You can still <a href="/data/">download the GeoJSON files</a> and explore them in your preferred mapping application.</p></noscript>
  </main>
</Layout>
<script>import '../scripts/map';</script>
<style>
.map-workspace{display:grid;grid-template-columns:285px 1fr;min-height:580px;border:1px solid var(--line);background:var(--paper)}.map-sidebar{padding:24px;border-right:1px solid var(--line)}.field-label{font-weight:600;display:block;font-size:15px;margin-bottom:10px}#map-choice{width:100%;font-size:14px}#map-description{font-size:13px;color:var(--muted);margin:12px 0 26px;min-height:42px}.layer-controls{border:0;margin:0 0 20px;padding:0}.layer-controls legend{font:700 26px var(--serif);margin-bottom:14px;width:100%;display:flex;justify-content:space-between;align-items:center}.layer-control{display:flex;gap:10px;align-items:center;padding:10px 0;min-height:55px}.layer-control input{margin:0}.layer-ballot{flex:none}.precinct-swatches{display:flex;width:16px;height:12px;flex:none}.precinct-swatches i{flex:1}.layer-control strong{font-weight:500;font-size:14px;display:block}.layer-control small{display:block;font-size:11px;color:var(--muted);margin-top:3px}.layer-swatch{width:11px;height:11px;background:var(--swatch);flex:none}.layer-swatch.point{border-radius:50%}.layer-swatch.line{height:3px}.layer-swatch.area{opacity:.6}.basemap-control{display:flex;align-items:center;gap:8px;font-size:13px;border-top:1px solid var(--line);padding-top:20px;min-height:44px}#fit-map{margin-top:16px;width:100%;font-size:13px}.map-help{font-size:12px;color:var(--muted);margin-top:18px}.map-sidebar .text-link{font-size:12px;margin-top:8px}.map-main{min-width:0;position:relative;background:#e4e8d9;display:flex;flex-direction:column}#map{width:100%;min-height:560px;flex:1;z-index:0;background:#e4e8d9}.map-loading{padding:40px;text-align:center}.map-main>.status{padding:10px 16px;background:var(--paper);font-size:12px;border-top:1px solid var(--line)}.map-message{padding:14px 18px;background:#f3e7d5;font-size:13px;line-height:1.6}.map-message button{margin-top:10px;font-size:12px}.place-directory{margin-top:40px}.directory-heading{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-bottom:18px}.directory-heading h2{font-size:36px}.directory-heading p{color:var(--muted);font-size:14px;margin-top:8px}.search-field{display:flex;align-items:center;gap:10px}.search-field input{width:260px}#directory-status{margin-bottom:12px}#place-list{display:grid;grid-template-columns:1fr 1fr;column-gap:40px}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:800px){.map-workspace{grid-template-columns:230px 1fr}.map-sidebar{padding:18px}#map{min-height:600px}.directory-heading{align-items:start;flex-direction:column}}
@media(max-width:600px){.map-workspace{display:flex;flex-direction:column}.map-sidebar{border-right:0;border-bottom:1px solid var(--line);padding:18px}.layer-controls{display:grid;grid-template-columns:1fr 1fr;gap:0 12px}.layer-controls legend{margin-bottom:8px}.layer-control{gap:6px}.layer-control strong{font-size:12px}.layer-control small{font-size:10px}#map-description{min-height:0;margin-bottom:18px}.basemap-control{padding-top:12px}#map{min-height:420px}.map-help{margin-top:12px}.map-sidebar .text-link{margin-top:0}#place-list{grid-template-columns:1fr}.directory-heading h2{font-size:32px}.search-field,.search-field input{width:100%}}
</style>
<style is:global>
.place-row{display:flex;align-items:center;gap:12px;padding:15px 0;border-top:1px solid var(--line)}.place-row .place-ballot{width:24px;flex:none}.place-row .place-ballot img{display:block}.place-row .place-dot{width:10px;height:10px;border-radius:50%;flex:none}.place-row div{flex:1;min-width:0}.place-row strong{font-size:15px;font-weight:500;display:block}.place-row small{font-size:12px;color:var(--muted)}.place-row button{font-size:12px;background:transparent;white-space:nowrap}.leaflet-container{font-family:var(--sans)!important}.leaflet-popup-content h3{font:700 24px var(--serif);margin:4px 0 8px}.leaflet-popup-content p{font-size:13px;margin:8px 0}.leaflet-popup-content small{font-size:11px;color:var(--rust-dark)}.leaflet-popup-content-wrapper{border-radius:4px!important}.leaflet-control-attribution{font-size:10px!important}.leaflet-container a{color:var(--ink)}
</style>
