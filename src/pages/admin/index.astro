---
import Layout from '../../layouts/Layout.astro';
import { cmsRefreshStatus } from '../../lib/cms-refresh-status';
const refreshStatus = cmsRefreshStatus(import.meta.env.PUBLIC_CONTENT_SOURCE);
---
<Layout title="Content editor · Civic Pulse" description="Staff content editor for Civic Pulse.">
  <main id="main" class="admin-main">
    <div class="page-intro admin-intro">
      <h1>Content management</h1>
      <p>Manage sourced records, review drafts and publish to the Civic Pulse API.</p>
    </div>

    <p id="resident-refresh-note" class="notice">{refreshStatus}</p>

    <section id="config-notice" class="notice" role="status" hidden>
      <strong>CMS setup needed.</strong> The public Supabase URL and publishable key must be configured for this site.
    </section>

    <section id="login-panel" class="admin-panel login-panel" aria-labelledby="login-heading" hidden>
      <h2 id="login-heading">Staff sign in</h2>
      <p>Sign in with an invited Civic Pulse staff account.</p>
      <form id="login-form">
        <label>Email address<input id="email" name="email" type="email" autocomplete="username" required /></label>
        <label>Password<input id="password" name="password" type="password" autocomplete="current-password" required /></label>
        <button class="button-primary" type="submit">Sign in</button>
      </form>
      <p id="login-message" class="form-message" role="alert" hidden></p>
    </section>

    <section id="access-panel" class="admin-panel access-panel" role="status" aria-live="polite" hidden>
      <h2 id="access-heading">Checking access</h2>
      <p id="access-message"></p>
      <button id="access-retry" type="button" hidden>Check staff access again</button>
      <button id="access-signout" type="button" hidden>Sign out</button>
    </section>

    <section id="workspace" hidden aria-label="CMS workspace">
      <div class="staff-bar">
        <div><span class="staff-email" id="staff-email"></span><span class="role-label" id="role-label"></span></div>
        <button id="signout" type="button">Sign out</button>
      </div>
      <nav class="cms-nav" aria-label="Content management">
        <a href="#records">Browse records</a>
        <a href="#editor">Edit a draft</a>
        <a href="#website-status">Website delivery</a>
        <a href="#publishing" id="publishing-nav" hidden>API publication</a>
      </nav>
      <section id="website-status" class="delivery-status" aria-labelledby="website-status-heading">
        <div class="section-heading"><div><h2 id="website-status-heading">Website delivery</h2><p>Draft saves, API publication and verified resident pages are separate.</p></div><button id="refresh-website-status" type="button" disabled>Refresh website status</button></div>
        <p id="website-status-message" role="status" aria-live="polite">Staff access must be verified before checking delivery.</p>
        <p id="website-record-message">Select a saved record to check its website revision.</p>
        <dl class="delivery-revisions"><div><dt>Saved draft revision</dt><dd id="website-draft-revision">No record selected</dd></div><div><dt>API published revision</dt><dd id="website-api-revision">No record selected</dd></div><div><dt>Last verified website revision</dt><dd id="website-live-revision">Unknown / not verified</dd></div></dl>
        <p id="website-live-tuple" class="field-help"></p><p id="website-status-checked" class="field-help"></p>
        <p class="field-help">Read-only checks run every 30 seconds while this tab is visible, for at most ten automatic checks. Errors stop automatic checks. Refresh checks status only; it never retries a CMS action or starts delivery.</p>
      </section>
      <div class="cms-layout">
        <section id="records" class="record-panel" aria-labelledby="records-heading">
          <div class="section-heading"><div><h2 id="records-heading">Records</h2><p>Choose a type to find its drafts.</p></div><button id="new-draft" type="button">New draft</button></div>
          <label class="kind-filter">Content type
            <select id="kind-filter">
              <option value="organization">Organizations</option>
              <option value="calendar">Calendars</option>
              <option value="event">Events</option>
              <option value="layer">Map layers</option>
              <option value="map">Maps</option>
            </select>
          </label>
          <div id="record-status" class="status-line" role="status" aria-live="polite"></div>
          <ul id="record-list" class="record-list" aria-label="Draft records"></ul>
          <button id="load-more" class="load-more" type="button" hidden>Load more</button>
          <p class="list-footnote">Lists show draft records. A publication may be newer or older than its current draft.</p>
        </section>

        <section id="editor" class="editor-panel" aria-labelledby="editor-heading">
          <div class="section-heading"><div><h2 id="editor-heading" tabindex="-1">Edit a draft</h2><p id="editor-summary">Select a record or start a new draft.</p></div><div class="editor-state"><strong id="draft-state">New draft</strong><span id="revision-label" class="revision-label"></span></div></div>
          <a class="back-to-records" href="#records">Back to records</a>
          <form id="editor-form">
            <div class="editor-identity">
              <label>Content type
                <select id="editor-kind" name="kind">
                  <option value="organization">Organization</option><option value="calendar">Calendar</option><option value="event">Event</option><option value="layer">Map layer</option><option value="map">Map</option>
                </select>
              </label>
              <label>Record ID<input id="record-id" name="id" autocomplete="off" required pattern="[a-z0-9][a-z0-9._-]*" aria-describedby="id-help" /></label>
            </div>
            <p id="id-help" class="field-help">Lowercase letters, numbers, dots, underscores, and hyphens.</p>
            <div id="structured-fields" class="structured-fields"></div>
            <details id="advanced-json" class="advanced-json">
              <summary>Advanced JSON &amp; source metadata</summary>
              <p class="field-help">This is the complete record. Fields not shown above, including source evidence and import provenance, stay here. Edit geometry and unusual value types in this view. Changes in either view require an explicit draft save.</p>
              <label for="payload">Complete record JSON</label>
              <textarea id="payload" name="payload" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="payload-help" required></textarea>
              <p id="payload-help" class="field-help">The id must match Record ID. Drafts can be incomplete; the API enforces publication rules. Private event data is rejected, never silently redacted.</p>
            </details>
            <div id="editor-message" class="form-message" role="status" aria-live="polite" hidden></div>
            <button id="reload-record" type="button" hidden>Reload saved record to check outcome</button>
            <section id="newer-state" class="conflict-panel" hidden><h3>A newer saved state is available</h3><p>Your previous action succeeded. Review this complete state before replacing local edits. This does not save or publish.</p><label>Newer draft, publication and activity<textarea id="newer-preview" readonly></textarea></label><button id="review-newer" type="button">Review newer saved state</button></section>
            <div id="conflict-panel" class="conflict-panel" role="alert" hidden>
              <h3>Someone saved a newer revision</h3>
              <p>Your text is still here. Compare it with the latest saved revision, then choose how to continue.</p>
              <div class="conflict-grid"><label>Your unsaved text<textarea id="conflict-local" readonly></textarea></label><label>Latest saved draft<textarea id="conflict-latest" readonly></textarea></label></div>
              <div class="button-row"><button id="keep-local" type="button">Keep my edits and continue</button><button id="load-latest" type="button">Load latest draft</button></div>
            </div>
            <div class="editor-actions">
              <div class="save-row"><button id="save-draft" class="button-primary" type="submit">Save draft</button><p>Save work without changing the API publication.</p></div>
              <section class="publication-controls" aria-labelledby="publication-heading">
                <h3 id="publication-heading">API publication</h3>
                <p id="publish-help" class="field-help">Save a draft, then review its saved payload.</p>
                <details class="saved-payload"><summary>Review exact saved payload</summary><pre id="saved-review">No saved revision yet.</pre></details>
                <div class="publication-row"><button id="publish" type="button" hidden disabled>Publish reviewed draft</button><button id="withdraw" class="button-danger" type="button" hidden disabled>Withdraw publication</button></div>
                <p class="field-help">Publishing is for administrators. Withdrawal keeps the draft and activity history.</p>
              </section>
            </div>
          </form>
          <div id="history-panel" class="history-panel" hidden>
            <h3>Recent activity</h3><ol id="history-list"></ol>
          </div>
        </section>
      </div>
      <aside id="publishing" class="notice publication-note" hidden>
        <strong>Publishing changes API records only.</strong> {refreshStatus}
      </aside>
    </section>
  </main>
</Layout>
<script>
  import '../../scripts/admin';
</script>
<style>
.admin-main { padding-bottom: 40px; }
.delivery-status { background: var(--paper); border: 1px solid var(--line); padding: 20px 24px; margin-bottom: 24px; }
.delivery-status .section-heading { margin-bottom: 12px; flex-wrap: wrap; }
.delivery-status h2 { font-size: 26px; }
.delivery-status > p { margin-top: 10px; line-height: 1.6; overflow-wrap: anywhere; }
.delivery-revisions { display: flex; gap: 16px 32px; flex-wrap: wrap; margin: 16px 0; }
.delivery-revisions div { min-width: 170px; flex: 1; }
.delivery-revisions dt { font-size: 13px; color: var(--muted); }
.delivery-revisions dd { margin: 6px 0 0; font-size: 14px; overflow-wrap: anywhere; }
.cms-nav { flex-wrap: wrap; }
.admin-intro { padding: 28px 0 20px; }
.admin-intro h1 { font-size: 42px; line-height: 1.12; }
.admin-intro p { font-size: 16px; margin-top: 10px; max-width: 70ch; }
.admin-panel, .record-panel, .editor-panel { background: var(--paper); border: 1px solid var(--line); padding: 24px; min-width: 0; }
.login-panel { max-width: 520px; }
.admin-panel h2 { font-size: 30px; }
.admin-panel > p { margin-top: 8px; color: var(--muted); }
.login-panel form { display: grid; gap: 16px; margin-top: 24px; }
.admin-main label, .kind-filter { display: grid; gap: 8px; font-size: 14px; font-weight: 500; min-width: 0; }
.admin-main input, .admin-main select, .admin-main textarea { font: 400 15px/1.5 var(--sans); color: var(--ink); background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: 10px 12px; min-height: 44px; width: 100%; caret-color: var(--ink); }
.admin-main textarea { resize: vertical; min-height: 108px; }
.admin-main textarea[readonly] { background: var(--canvas); }
.admin-main :is(input, select, textarea):disabled { opacity: .7; cursor: not-allowed; }
.admin-main :is(input, textarea)::placeholder { color: var(--muted); }
.admin-main ::selection { background: var(--sage); color: var(--ink); }
.admin-main :is(button, summary, a, input, select, textarea):focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
.admin-main button { font: 500 14px/1.4 var(--sans); min-height: 44px; padding: 10px 16px; border: 1px solid var(--line); border-radius: 4px; background: var(--paper); color: var(--ink); cursor: pointer; }
.admin-main button:hover:not(:disabled) { background: var(--sage); }
.admin-main .button-primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.admin-main .button-primary:hover:not(:disabled) { background: var(--focus); }
.admin-main button:disabled { opacity: .55; cursor: not-allowed; }
.admin-main .button-danger { color: var(--rust-dark); border-color: var(--rust); }
.admin-main .button-danger:hover:not(:disabled) { background: #f2e5dd; }
.notice { border: 1px solid #c89562; background: #f4ead9; color: #603d20; padding: 14px 18px; margin: 0 0 24px; font-size: 14px; line-height: 1.6; max-width: 100%; }
.access-panel { max-width: 740px; }
.access-panel button { margin: 16px 8px 0 0; }
.staff-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 12px; }
.staff-bar > div { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; min-width: 0; }
.staff-email { font-size: 14px; overflow-wrap: anywhere; }
.role-label { font-size: 13px; color: var(--muted); }
.cms-nav { display: flex; gap: 24px; border-bottom: 1px solid var(--line); margin-bottom: 24px; }
.cms-nav a { display: flex; align-items: center; min-height: 48px; color: var(--ink); text-decoration: none; text-underline-offset: 5px; border-bottom: 2px solid transparent; font-size: 14px; }
.cms-nav a:hover { border-color: var(--rust); }
.cms-layout { display: grid; grid-template-columns: minmax(260px, 300px) minmax(0, 1fr); gap: 24px; align-items: start; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
.section-heading h2 { font-size: 28px; line-height: 1.12; }
.section-heading p { font-size: 14px; color: var(--muted); margin-top: 8px; overflow-wrap: anywhere; }
.record-panel .section-heading { display: grid; gap: 16px; }
.record-panel #new-draft { width: 100%; }
.kind-filter { margin-bottom: 16px; }
.status-line { font-size: 13px; color: var(--muted); min-height: 24px; margin-bottom: 12px; }
.record-list { list-style: none; padding: 0; margin: 0; }
.record-list li { border-top: 1px solid var(--line); }
.record-list li:last-child { border-bottom: 1px solid var(--line); }
.record-list :global(.record-button) { width: 100%; text-align: left; border: 0; border-radius: 0; background: transparent; display: block; padding: 16px 8px; min-height: 68px; }
.record-list :global(.record-button[aria-current=true]) { background: #e9eee3; text-decoration: underline; text-underline-offset: 4px; }
.record-list :global(.record-name) { display: block; font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
.record-list :global(.record-meta) { display: block; color: var(--muted); font-size: 12px; margin-top: 6px; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.load-more { margin-top: 16px; }
.list-footnote, .field-help, .structured-fields :global(.field-help) { font-size: 13px; font-weight: 400; color: var(--muted); line-height: 1.55; }
.list-footnote { margin-top: 16px; }
.editor-state { display: grid; gap: 6px; font-size: 13px; text-align: right; min-width: 140px; }
.editor-state strong { font-weight: 600; color: var(--ink); }
.revision-label { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
.editor-identity { display: grid; grid-template-columns: minmax(140px, .65fr) minmax(0, 1fr); gap: 16px; }
#id-help { margin: 8px 0 0; }
.structured-fields :global(.field-group) { border: 0; border-top: 1px solid var(--line); padding: 24px 0 0; margin: 24px 0 0; min-width: 0; }
.structured-fields :global(legend) { font: 700 22px/1.2 var(--serif); padding: 0 12px 0 0; }
.structured-fields :global(.field-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 16px; }
.structured-fields :global(.wide-field) { grid-column: 1 / -1; }
.structured-fields :global(label) { display: grid; gap: 8px; font: 500 14px/1.5 var(--sans); min-width: 0; align-content: start; }
.structured-fields :global(input), .structured-fields :global(textarea), .structured-fields :global(select) { font: 400 15px/1.5 var(--sans); color: var(--ink); background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: 10px 12px; min-height: 44px; width: 100%; }
.structured-fields :global(textarea) { min-height: 108px; resize: vertical; }
.structured-fields :global(:disabled) { opacity: .7; cursor: not-allowed; }
.structured-fields :global(:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
.advanced-json, .saved-payload { margin-top: 24px; border-top: 1px solid var(--line); padding-top: 8px; }
.admin-main summary { cursor: pointer; min-height: 44px; padding: 12px 0; font-size: 14px; font-weight: 500; color: var(--ink); }
.advanced-json > p { margin: 0 0 16px; max-width: 70ch; }
#payload, .conflict-grid textarea, #newer-preview, #saved-review { font: 13px/1.6 ui-monospace, SFMono-Regular, Consolas, monospace; tab-size: 2; overflow-wrap: anywhere; }
#payload { min-height: 320px; margin-top: 8px; }
.form-message { margin: 24px 0 0; padding: 16px; border: 1px solid var(--line); background: var(--canvas); font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.form-message.error { border-color: var(--rust); background: #f3e5dd; color: #70351f; }
.form-message.success { border-color: #8ba28c; background: #e9eee3; color: #214b39; }
#reload-record { margin-top: 12px; }
.button-row, .publication-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
.editor-actions { border-top: 1px solid var(--line); padding-top: 24px; margin-top: 24px; }
.save-row { display: flex; align-items: center; gap: 16px; }
.save-row p { font-size: 13px; color: var(--muted); max-width: 40ch; }
.publication-controls { margin-top: 28px; border-top: 1px solid var(--line); padding-top: 24px; }
.publication-controls h3, .history-panel h3, .conflict-panel h3 { font: 700 23px/1.2 var(--serif); }
.publication-controls > p { margin-top: 8px; }
.publication-row #publish { background: var(--ink); color: var(--paper); border-color: var(--ink); }
.publication-row #publish:hover:not(:disabled) { background: var(--focus); }
.saved-payload { margin-top: 12px; border-top: 0; padding-top: 0; }
#saved-review { white-space: pre-wrap; max-height: 360px; overflow: auto; padding: 16px; background: var(--canvas); border: 1px solid var(--line); }
.conflict-panel { border: 1px solid var(--rust); background: #f8f0e9; padding: 20px; margin-top: 24px; }
.conflict-panel p { margin: 8px 0 16px; font-size: 14px; line-height: 1.6; }
.conflict-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.conflict-grid textarea { min-height: 220px; }
.history-panel { border-top: 1px solid var(--line); padding-top: 24px; margin-top: 28px; }
.history-panel ol { padding-left: 24px; }
.history-panel :global(li) { font-size: 13px; line-height: 1.6; margin-top: 12px; font-variant-numeric: tabular-nums; }
.publication-note { margin-top: 24px; }
.back-to-records { display: none; }
@media (max-width: 950px) {
  .cms-layout { grid-template-columns: 250px minmax(0, 1fr); gap: 16px; }
  .record-panel, .editor-panel { padding: 20px; }
  .editor-panel > .section-heading { display: grid; }
  .editor-state { text-align: left; }
  .structured-fields :global(.field-grid) { grid-template-columns: 1fr; }
}
@media (max-width: 760px) {
  .cms-layout { grid-template-columns: 1fr; }
  .record-panel .section-heading { grid-template-columns: 1fr auto; align-items: center; }
  .record-panel #new-draft { width: auto; }
  .editor-panel > .section-heading { display: flex; }
  .editor-state { text-align: right; }
  .back-to-records { display: inline-flex; min-height: 44px; align-items: center; font-size: 14px; margin-bottom: 16px; text-underline-offset: 4px; }
  .record-list { max-height: 280px; overflow-y: auto; }
}
@media (max-width: 500px) {
  .admin-intro h1 { font-size: 36px; }
  .admin-intro p { font-size: 15px; }
  .admin-panel, .record-panel, .editor-panel { padding: 16px; }
  .staff-bar { align-items: flex-start; }
  .cms-nav { gap: 16px; overflow-x: auto; }
  .cms-nav a { white-space: nowrap; font-size: 13px; }
  .editor-panel > .section-heading { display: grid; gap: 12px; }
  .editor-state { text-align: left; }
  .editor-identity, .conflict-grid { grid-template-columns: 1fr; }
  .save-row { align-items: flex-start; flex-direction: column; gap: 12px; }
  .save-row .button-primary, .publication-row button { width: 100%; }
  .conflict-panel { padding: 16px; }
}
</style>
