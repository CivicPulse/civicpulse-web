---
import Layout from '../../layouts/Layout.astro';
import { cmsRefreshStatus } from '../../lib/cms-refresh-status';
const refreshStatus = cmsRefreshStatus(import.meta.env.PUBLIC_CONTENT_SOURCE);
---
<Layout title="Content editor · Civic Pulse" description="Staff content editor for Civic Pulse.">
  <main id="main" class="admin-main">
    <div class="page-intro admin-intro">
      <h1>Content editor</h1>
      <p>Review and edit sourced community information in the Civic Pulse API.</p>
    </div>

    <p id="resident-refresh-note" class="notice">{refreshStatus}</p>

    <section id="config-notice" class="notice" role="status" hidden>
      <strong>CMS setup needed.</strong> The public Supabase URL and publishable key must be configured for this site.
    </section>

    <section id="login-panel" class="admin-panel login-panel" aria-labelledby="login-heading" hidden>
      <h2 id="login-heading">Staff sign in</h2>
      <p>Sign in with an invited Civic Pulse staff account.</p>
      <form id="login-form">
        <label>Email address<input id="email" name="email" type="email" autocomplete="username" required /></label>
        <label>Password<input id="password" name="password" type="password" autocomplete="current-password" required /></label>
        <button class="button-primary" type="submit">Sign in</button>
      </form>
      <p id="login-message" class="form-message" role="alert" hidden></p>
    </section>

    <section id="access-panel" class="admin-panel access-panel" role="status" aria-live="polite" hidden>
      <h2 id="access-heading">Checking access</h2>
      <p id="access-message"></p>
      <button id="access-signout" type="button" hidden>Sign out</button>
    </section>

    <section id="workspace" hidden aria-label="CMS workspace">
      <div class="staff-bar">
        <div><span class="staff-email" id="staff-email"></span><span class="role-label" id="role-label"></span></div>
        <button id="signout" type="button">Sign out</button>
      </div>
      <nav class="cms-nav" aria-label="Content management">
        <a href="#records" aria-current="page">Content records</a>
        <a href="#editor">Draft editor</a>
        <a href="#publishing" id="publishing-nav" hidden>Publishing</a>
      </nav>
      <div class="cms-layout">
        <section id="records" class="record-panel" aria-labelledby="records-heading">
          <div class="section-heading"><div><h2 id="records-heading">Content records</h2><p>Choose a type, then select a draft to edit.</p></div><button id="new-draft" type="button">New draft</button></div>
          <label class="kind-filter">Content type
            <select id="kind-filter">
              <option value="organization">Organizations</option>
              <option value="calendar">Calendars</option>
              <option value="event">Events</option>
              <option value="layer">Map layers</option>
              <option value="map">Maps</option>
            </select>
          </label>
          <div id="record-status" class="status-line" role="status" aria-live="polite"></div>
          <ul id="record-list" class="record-list" aria-label="Draft records"></ul>
          <button id="load-more" class="load-more" type="button" hidden>Load more</button>
          <p class="list-footnote">Lists show draft records. A publication may be newer or older than its current draft.</p>
        </section>

        <section id="editor" class="editor-panel" aria-labelledby="editor-heading">
          <div class="section-heading"><div><h2 id="editor-heading">Draft editor</h2><p id="editor-summary">Select a record or start a new draft.</p></div><span id="revision-label" class="revision-label"></span></div>
          <form id="editor-form">
            <div class="editor-identity">
              <label>Content type
                <select id="editor-kind" name="kind">
                  <option value="organization">Organization</option><option value="calendar">Calendar</option><option value="event">Event</option><option value="layer">Map layer</option><option value="map">Map</option>
                </select>
              </label>
              <label>Record ID<input id="record-id" name="id" autocomplete="off" required pattern="[a-z0-9][a-z0-9._-]*" aria-describedby="id-help" /></label>
            </div>
            <p id="id-help" class="field-help">Lowercase letters, numbers, dots, underscores, and hyphens.</p>
            <label for="payload">Complete JSON payload</label>
            <p class="field-help">All fields are preserved when you save. Keep source links, capture dates, source fields, and import provenance intact. Drafts may be incomplete; publication checks are enforced by the API.</p>
            <textarea id="payload" name="payload" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="payload-help" required></textarea>
            <p id="payload-help" class="sr-only">Edit the entire JSON record. The id value must match the Record ID field.</p>
            <div id="editor-message" class="form-message" role="status" aria-live="polite" hidden></div>
            <div id="conflict-panel" class="conflict-panel" role="alert" hidden>
              <h3>Someone saved a newer revision</h3>
              <p>Your text is still here. Compare it with the latest saved revision, then choose how to continue.</p>
              <div class="conflict-grid"><label>Your unsaved text<textarea id="conflict-local" readonly></textarea></label><label>Latest saved draft<textarea id="conflict-latest" readonly></textarea></label></div>
              <div class="button-row"><button id="keep-local" type="button">Keep my edits and continue</button><button id="load-latest" type="button">Load latest draft</button></div>
            </div>
            <div class="button-row editor-actions">
              <button id="save-draft" class="button-primary" type="submit">Save draft</button>
              <button id="publish" type="button" hidden disabled>Publish reviewed draft</button>
              <button id="withdraw" class="button-danger" type="button" hidden disabled>Withdraw publication</button>
            </div>
          </form>
          <div id="history-panel" class="history-panel" hidden>
            <h3>Recent activity</h3><ol id="history-list"></ol>
          </div>
        </section>
      </div>
      <aside id="publishing" class="notice publication-note" hidden>
        <strong>Publishing changes API records only.</strong> {refreshStatus}
      </aside>
    </section>
  </main>
</Layout>
<script>
  import '../../scripts/admin';
</script>
<style>
.admin-main{padding-bottom:20px}.admin-intro{padding-bottom:24px}.admin-intro h1{font-size:clamp(40px,5vw,64px)}.admin-panel,.record-panel,.editor-panel{background:var(--paper);border:1px solid var(--line);padding:24px}.login-panel{max-width:560px}.admin-panel h2,.section-heading h2{font-size:30px}.admin-panel>p,.section-heading p{margin-top:5px;color:var(--muted);font-size:14px}.login-panel form{display:grid;gap:16px;margin-top:22px}.login-panel label,.editor-panel label,.kind-filter{display:grid;gap:7px;font-size:14px;font-weight:500}.admin-main input,.admin-main select,.admin-main textarea{font:400 15px/1.5 var(--sans);color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:4px;padding:10px 12px;min-height:44px;width:100%}.admin-main textarea{min-height:390px;resize:vertical;font:13px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace;tab-size:2}.button-primary,.admin-main button{font:500 14px/1.4 var(--sans);min-height:44px;padding:10px 15px;border:1px solid var(--line);border-radius:4px;background:var(--paper);color:var(--ink);cursor:pointer}.admin-main button:hover{background:var(--sage)}.admin-main .button-primary{background:var(--ink);color:var(--paper);border-color:var(--ink)}.admin-main .button-primary:hover{background:#2a594b}.admin-main button:disabled{opacity:.5;cursor:not-allowed}.admin-main .button-danger{color:#7a3526;border-color:#ae583b}.admin-main .button-danger:hover{background:#f2e5dd}.notice{border:1px solid #c89562;background:#f4ead9;color:#603d20;padding:16px 18px;margin:0 0 20px;line-height:1.6}.access-panel{max-width:740px}.access-panel button{margin-top:12px}.staff-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line);padding:0 0 14px}.staff-bar>div{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.staff-email{font-size:14px}.role-label,.revision-label{font-size:12px;color:var(--muted)}.cms-nav{display:flex;gap:24px;border-bottom:1px solid var(--line);margin-bottom:22px}.cms-nav a{display:flex;align-items:center;min-height:48px;color:var(--ink);text-decoration:none;border-bottom:2px solid transparent;font-size:14px}.cms-nav a:hover,.cms-nav a[aria-current=page]{border-color:var(--rust)}.cms-layout{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(0,1.6fr);gap:20px;align-items:start}.section-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px}.section-heading h2{font-size:28px}.kind-filter{margin-bottom:14px}.status-line{font-size:13px;color:var(--muted);min-height:24px}.record-list{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}.record-list li{border-bottom:1px solid var(--line)}.record-button{width:100%;text-align:left;border:0!important;border-radius:0!important;background:transparent!important;display:block;padding:12px 8px!important;min-height:60px!important}.record-button[aria-current=true]{box-shadow:inset 3px 0 var(--rust);background:#f4efe4!important}.record-name{display:block;font-size:14px;font-weight:600;overflow-wrap:anywhere}.record-meta{display:block;color:var(--muted);font-size:12px;margin-top:3px}.load-more{margin-top:14px}.list-footnote,.field-help{font-size:12px;color:var(--muted);line-height:1.55;margin-top:10px}.editor-identity{display:grid;grid-template-columns:minmax(150px,.7fr) minmax(200px,1fr);gap:14px;margin:20px 0 0}.field-help{margin:5px 0 16px}.editor-panel form>label[for=payload]{margin-top:16px}.form-message{margin:14px 0;padding:12px 14px;border:1px solid var(--line);background:#f4efe4;font-size:14px;line-height:1.55;overflow-wrap:anywhere}.form-message.error{border-color:#ae583b;background:#f3e5dd;color:#70351f}.form-message.success{border-color:#8ba28c;background:#e9eee3;color:#214b39}.button-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}.editor-actions{border-top:1px solid var(--line);padding-top:16px;margin-top:18px}.conflict-panel{border:1px solid #ae583b;background:#f8f0e9;padding:16px;margin-top:16px}.conflict-panel h3,.history-panel h3{font:700 22px/1.15 var(--serif)}.conflict-panel p{margin-top:7px;font-size:13px;line-height:1.55}.conflict-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.conflict-grid textarea{min-height:220px}.history-panel{border-top:1px solid var(--line);padding-top:16px;margin-top:22px}.history-panel ol{padding-left:20px}.history-panel li{font-size:13px;line-height:1.55;margin:8px 0}.publication-note{margin-top:20px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:850px){.cms-layout{grid-template-columns:1fr}.record-panel{order:0}.editor-panel{order:1}.record-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:0;gap:0 14px}.record-list li{border-top:1px solid var(--line)}.list-footnote{margin-bottom:0}}
@media(max-width:600px){.admin-panel,.record-panel,.editor-panel{padding:17px}.staff-bar{align-items:flex-start}.cms-nav{gap:16px;overflow-x:auto}.cms-nav a{white-space:nowrap}.record-list{grid-template-columns:1fr}.section-heading{align-items:center}.section-heading h2{font-size:25px}.section-heading p{font-size:12px}.editor-identity,.conflict-grid{grid-template-columns:1fr}.admin-main textarea{min-height:300px}.conflict-grid textarea{min-height:160px}.admin-intro h1{font-size:42px}}
</style>
