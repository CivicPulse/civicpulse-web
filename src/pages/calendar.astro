---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import EventItem from '../components/EventItem.astro';
import { events } from '../lib/events';
const categories = [...new Set(events.map(event => event.category))];
---
<Layout title="Community calendar" description="Browse a sample calendar of Macon–Bibb community events. Filter by category, explore dates and download events.">
  <main id="main">
    <div class="page-intro"><h1>Good things happen together.</h1><p>Find a reason to get out, meet your neighbors, and be part of Macon–Bibb.</p></div>
    <p class="sample-notice"><strong>Demonstration calendar.</strong> Every event below is fictional sample content. These are not scheduled gatherings. Times use America/New_York.</p>
    <div class="calendar-toolbar">
      <label class="calendar-search"><span>Find an event</span><input type="search" id="event-search" placeholder="Search events or places" /></label>
      <label><span id="category-label">Category</span><select id="event-category" aria-labelledby="category-label"><option value="all">All categories</option>{categories.map(category => <option>{category}</option>)}</select></label>
      <a class="download-calendar text-link" href="/events.ics" download><Icon name="download" size={18} /> Download sample calendar</a>
    </div>
    <div class="calendar-layout">
      <section class="month-panel" aria-labelledby="month-title">
        <div class="month-heading"><h2 id="month-title" aria-live="polite">Community calendar</h2><div class="month-controls"><button id="previous-month" aria-label="Previous month"><Icon name="chevron-left" size={18}/></button><button id="today">Today</button><button id="next-month" aria-label="Next month"><Icon name="chevron-right" size={18}/></button></div></div>
        <div class="view-switch" role="group" aria-label="Calendar view"><button data-view="month" aria-pressed="true">Month</button><button data-view="agenda" aria-pressed="false">Agenda</button></div>
        <div id="month-view"><div class="weekdays" aria-hidden="true">{['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(day => <span>{day}</span>)}</div><div id="calendar-grid" aria-label="Choose a day"></div><p class="month-hint">A dot marks a day with sample events. Select a day to see its events.</p></div>
        <div id="agenda-summary" hidden><p>All matching events for this month appear in the event list.</p></div>
        <div class="calendar-key"><span class="calendar-key-dot" aria-hidden="true"></span> Sample event <span class="today-key" aria-hidden="true"></span> Today</div>
      </section>
      <section class="event-list-panel" aria-labelledby="list-heading">
        <div class="list-heading"><h2 id="list-heading">Events this month</h2><button id="clear-day" hidden>Show whole month</button></div>
        <p id="event-count" role="status" class="status"></p>
        <div id="events-list">{events.map(event => <EventItem event={event}/>)}</div>
        <div id="events-empty" class="empty-state" hidden><h3>No events to show.</h3><p id="empty-explanation">Try another month or clear your filters.</p><button id="reset-filters">Clear filters</button></div>
      </section>
    </div>
    <noscript><p class="sample-notice">JavaScript is off. All sample events are listed above, and event details and calendar downloads still work.</p></noscript>
  </main>
</Layout>
<script>import '../scripts/calendar';</script>
<style>
.calendar-toolbar{display:flex;align-items:end;gap:20px;padding:0 0 26px}.calendar-toolbar label{display:flex;flex-direction:column;gap:9px;font-size:14px;font-weight:500}.calendar-search{flex:1}.calendar-toolbar input{width:100%}.calendar-toolbar select{min-width:180px}.download-calendar{font-size:13px;margin-left:auto;white-space:nowrap;padding-bottom:10px}.calendar-layout{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,1fr);gap:40px}.month-panel{background:var(--paper);padding:26px;border:1px solid var(--line);align-self:start}.month-heading{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.month-heading h2{font-size:34px}.month-controls{display:flex;gap:6px}.month-controls button{min-width:44px;padding:8px;font-size:12px}.view-switch{display:flex;margin:22px 0 24px;border-bottom:1px solid var(--line);gap:22px}.view-switch button{border:0;border-radius:0;background:transparent;padding:8px 0;font-size:14px}.view-switch button[aria-pressed=true]{box-shadow:inset 0 -2px var(--rust);color:var(--rust-dark)}.weekdays{display:grid;grid-template-columns:repeat(7,1fr);font-size:12px;color:var(--muted);text-align:center;margin-bottom:10px}#calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:3px}.month-hint{font-size:12px;color:var(--muted);line-height:1.5;margin-top:16px}.calendar-key{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px;margin-top:24px;padding-top:18px;border-top:1px solid var(--line)}.calendar-key-dot{height:6px;width:6px;background:var(--rust);border-radius:50%}.today-key{width:16px;height:16px;border:1px solid var(--ink);border-radius:50%;margin-left:16px}.list-heading{display:flex;justify-content:space-between;align-items:center;gap:10px;min-height:44px;margin-bottom:10px}.list-heading h2{font-size:34px}.list-heading button{font-size:12px;padding:8px}#event-count{margin-bottom:14px}#agenda-summary p{font-size:16px;line-height:1.7;padding:30px 0}#events-empty h3{font-size:30px;margin-bottom:12px}#events-empty button{margin-top:16px}
@media(max-width:1100px){.calendar-layout{gap:24px}.month-panel{padding:20px}.calendar-toolbar{flex-wrap:wrap}.download-calendar{margin-left:0}.month-heading h2{font-size:30px}.list-heading h2{font-size:30px}}@media(max-width:850px){.calendar-layout{grid-template-columns:1fr}.calendar-toolbar{gap:16px}.download-calendar{width:100%;padding:0}.month-panel{padding:20px}.month-heading{flex-wrap:nowrap}.month-heading h2{font-size:32px}}@media(max-width:450px){.calendar-search{min-width:100%}.calendar-toolbar label:nth-child(2){width:100%}.month-panel{padding:14px}.month-heading h2{font-size:28px}.month-controls{gap:3px}.month-controls button{min-width:44px;padding:6px}.list-heading h2{font-size:30px}.calendar-key{font-size:11px}.month-heading{gap:6px}}
</style>
<style is:global>
.day-cell{border:0;background:transparent;border-radius:0;min-height:64px;position:relative;padding:10px 4px;font-size:14px;display:flex;flex-direction:column;align-items:center;gap:7px;font-variant-numeric:tabular-nums}.day-cell:disabled{opacity:1;background:transparent}.day-cell .day-number{width:29px;height:29px;display:grid;place-items:center;border:1px solid transparent;border-radius:50%}.day-cell.is-today .day-number{border-color:var(--ink)}.day-cell.has-events{background:#f0eee4}.day-cell[aria-pressed=true]{background:var(--ink);color:var(--paper)}.event-dot{width:5px;height:5px;border-radius:50%;background:var(--rust)}.day-cell[aria-pressed=true] .event-dot{background:var(--paper)}.calendar-event{display:grid;grid-template-columns:58px 1fr;gap:18px;border-top:1px solid var(--line);padding:22px 0;scroll-margin-top:24px}.list-date{display:flex;flex-direction:column;align-items:center;color:var(--rust);padding-top:2px;font-variant-numeric:tabular-nums}.list-date span{font-size:13px;text-transform:uppercase}.list-date strong{font:52px/1 var(--serif)}.event-category{font-size:11px;margin-top:8px;margin-bottom:0;color:var(--rust-dark)}.event-category span{color:var(--muted)}.event-body h3{font-size:29px;line-height:1.08}.event-meta{font-size:12px;margin-top:10px;line-height:1.6}.event-place{font-size:13px;color:var(--muted);margin-top:3px}.event-body details{font-size:13px;margin-top:12px}.event-body summary{min-height:44px;padding:11px 0;text-underline-offset:4px;text-decoration:underline}.event-body details p{margin:10px 0;line-height:1.6}.fictional-note{color:var(--rust-dark);font-size:12px}.event-actions{display:flex;gap:10px 22px;flex-wrap:wrap;margin-top:12px}.event-actions a{min-height:44px;display:flex;align-items:center;font-size:12px}.calendar-event:target{background:#eeeddf}@media(max-width:450px){.day-cell{min-height:54px;font-size:13px}.day-cell .day-number{width:26px;height:26px}.calendar-event{gap:12px;grid-template-columns:45px 1fr}.event-body h3{font-size:27px}.list-date strong{font-size:46px}}
</style>
