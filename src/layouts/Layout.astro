---
import '../styles/global.css';
import '@fontsource/unna/400.css';
import '@fontsource/unna/700.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
interface Props { title: string; description?: string; }
const { title, description = 'Explore community and voting maps and a sample calendar of local events in Macon–Bibb.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [{ url: '/', label: 'Home' }, { url: '/maps/', label: 'Explore maps' }, { url: '/calendar/', label: 'Community calendar' }];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f1e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · Macon–Bibb</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="brand" aria-label="Macon–Bibb home">Macon–Bibb</a>
        <nav aria-label="Main navigation">
          {nav.map(item => <a href={item.url} aria-current={path === item.url ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p>Preview site <span aria-hidden="true">·</span> Voting data &amp; sample community content</p>
        <div><a href="/about/">About this project</a><span aria-hidden="true">/</span><a href="/data/">Data & sources</a></div>
      </footer>
    </div>
  </body>
</html>
