  "narrative": {
    "northStar": "Neighborhood noticeboard",
    "overview": "The neighborhood noticeboard pairs generous editorial headings with practical, readable controls. Cream paper, forest ink, sage geography and terracotta dates give the community prototype a warm, local character without implying official affiliation.\n\nRectangular panels and fine dividers organize content. Date columns and map-layer swatches provide useful structure; typography and restrained color carry the hierarchy.",
    "keyCharacteristics": [
      "Warm paper and forest ink.",
      "Unna headings with DM Sans controls and prose.",
      "Flat rectangular panels and fine dividing rules.",
      "Geographic layers and event dates remain legible alongside sample-content notices."
    ],
    "rules": [
      {
        "name": "The Paper Rule",
        "body": "Use canvas for the page and paper for content surfaces; use sage and rust to distinguish geographic and calendar destinations.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Unna for headings, dates and destination links; use DM Sans for prose, navigation and controls.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and changes of background to separate application panels; reserve map-library popup shadows for the map overlay.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve forest text, cream ground and the sage/terracotta relationship.",
      "Do keep sample and illustrative-content notices visible as readable text.",
      "Do use native controls, visible keyboard focus and tabular date numerals.",
      "Do keep geographic layer swatches consistent with the map features."
    ],
    "donts": [
      "Don't add decorative card shadows or pill-shaped application panels.",
      "Don't replace Unna headings with a system display face or the obsolete Lora specification.",
      "Don't imply official affiliation or present the generated preview as geographic evidence."
    ]
  }
